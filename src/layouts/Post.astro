---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Base from './Base.astro';
import { postPath } from '../lib';
import { SITE, TYPE_LABEL, formatDate } from '../site';

interface Props {
  post: CollectionEntry<'novice'>;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
// Table of contents for longer guides.
const toc = post.data.type === 'vodnik' ? headings.filter((h) => h.depth === 2) : [];
---


<Base
  title={post.data.title}
  description={post.data.description}
  type="article"
  published={post.data.date}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': post.data.type === 'tedenski-pregled' ? 'NewsArticle' : 'Article',
      headline: post.data.title,
      description: post.data.description,
      datePublished: post.data.date.toISOString(),
      inLanguage: 'sl-SI',
      author: { '@id': `${Astro.site}#avtor` },
      publisher: { '@id': `${Astro.site}#avtor` },
      mainEntityOfPage: new URL(postPath(post), Astro.site).toString(),
      image: new URL('/og.png', Astro.site).toString(),
    },
  ]}
>
  <article class="wrap narrow">
    <header class="article-head">
      <div class="meta">
        <span class="tag">{TYPE_LABEL[post.data.type]}</span>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        {post.data.period && <span>Obdobje: {post.data.period}</span>}
      </div>
      <h1>{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
    </header>
    {
      toc.length >= 4 && (
        <nav class="toc" aria-label="Vsebina">
          <strong>Vsebina</strong>
          <ol>
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <div class="prose">
      <Content />
    </div>
    <p class="disclosure">
      Pri pripravi je pomagal AI (Claude). Vsako trditev smo preverili pri navedenem viru, besedilo
      je pred objavo pregledal in uredil {SITE.author}. Ste opazili napako?
      <a href="https://github.com/AnzeNocAI/ej-aj/issues">Sporočite jo na GitHubu</a>.
    </p>
  </article>
</Base>
