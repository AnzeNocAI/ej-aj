---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatDate } from '../site';

const PRODUCT_ORDER = ['ChatGPT', 'Claude', 'Gemini', 'Microsoft Copilot', 'Mistral Le Chat', 'Perplexity'];
const plans = (await getCollection('narocnine')).sort((a, b) => {
  const pa = PRODUCT_ORDER.indexOf(a.data.produkt);
  const pb = PRODUCT_ORDER.indexOf(b.data.produkt);
  if (pa !== pb) return (pa === -1 ? 99 : pa) - (pb === -1 ? 99 : pb);
  const pa2 = a.data.cena_mesec ?? a.data.cena_letno ?? 1e9;
  const pb2 = b.data.cena_mesec ?? b.data.cena_letno ?? 1e9;
  return pa2 - pb2;
});

const groups = [
  { key: 'posameznik', title: 'Za posameznike' },
  { key: 'podjetje', title: 'Za podjetja in ekipe' },
] as const;

const lastChecked = new Date(Math.max(...plans.map((p) => p.data.preverjeno.valueOf())));
const money = new Intl.NumberFormat('sl-SI', { minimumFractionDigits: 0, maximumFractionDigits: 2 });

function price(v: number | null, currency: string) {
  if (v === null) return 'po dogovoru';
  if (v === 0) return 'brezplačno';
  return `${money.format(v)} ${currency === 'EUR' ? '€' : '$'}`;
}
// Slovenian plural: 1 uporabnik, 2 uporabnika, 3-4 uporabniki, 5+ uporabnikov.
function users(n: number) {
  const m = n % 100;
  if (m === 1) return `${n} uporabnik`;
  if (m === 2) return `${n} uporabnika`;
  if (m === 3 || m === 4) return `${n} uporabniki`;
  return `${n} uporabnikov`;
}
function host(url: string) {
  return new URL(url).hostname.replace(/^www\./, '');
}
---

<Base
  title="Cene AI orodij: ChatGPT, Claude, Gemini, Copilot"
  description="Koliko stanejo naročnine na ChatGPT, Claude, Gemini, Microsoft Copilot in druga AI orodja za posameznike in podjetja. Z viri in datumom preverjanja."
>
  <div class="wrap">
    <header class="article-head narrow">
      <span class="eyebrow">Cene</span>
      <h1>Koliko stanejo AI orodja?</h1>
      <p class="lede">
        Mesečne naročnine za ChatGPT, Claude, Gemini, Microsoft Copilot in druga orodja, za
        posameznike in za podjetja. Vsaka cena ima vir. Zadnje preverjanje: {formatDate(lastChecked)}.
      </p>
    </header>

    <p class="how narrow">
      Cene so na uporabnika na mesec. Kjer ponudnik nudi popust za letno plačilo, je naveden
      posebej. Ponudniki cene pogosto prilagajajo državi, zato se lahko cena v Sloveniji malenkost
      razlikuje; pri vsaki postavki je označeno, ali vključuje DDV. Za uporabo prek API-ja glejte
      <a href="/modeli/">primerjavo modelov</a>.
    </p>

    {
      groups.map((g) => {
        const rows = plans.filter((p) => p.data.za === g.key);
        return (
          <section class="group">
            <h2>{g.title}</h2>
            <div class="table-wrap">
              <table class="plans">
                <thead>
                  <tr>
                    <th scope="col">Paket</th>
                    <th scope="col" class="num">Mesečno</th>
                    <th scope="col" class="num">Pri letnem plačilu</th>
                    <th scope="col">Kaj dobite</th>
                  </tr>
                </thead>
                <tbody>
                  {rows.map((p) => (
                    <tr id={p.id}>
                      <th scope="row">
                        <span class="name">
                          {p.data.produkt} {p.data.paket}
                        </span>
                        {p.data.min_uporabnikov && (
                          <span class="sub">najmanj {users(p.data.min_uporabnikov)}</span>
                        )}
                      </th>
                      <td class="num" data-label="Mesečno">
                        {p.data.cena_mesec === null && p.data.cena_letno !== null
                          ? 'samo letno'
                          : price(p.data.cena_mesec, p.data.valuta)}
                      </td>
                      <td class="num" data-label="Pri letnem plačilu">
                        {p.data.cena_letno === null ? 'ni' : price(p.data.cena_letno, p.data.valuta)}
                      </td>
                      <td class="use" data-label="Kaj dobite">
                        {p.data.kaj_dobite}
                        {p.data.opomba && <span class="note">{p.data.opomba}</span>}
                        <span class="sources">
                          {p.data.ddv && <>{p.data.ddv}. </>}Vir: <a href={p.data.vir}>{host(p.data.vir)}</a>
                        </span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        );
      })
    }

    <div class="prose narrow notes">
      <h2>Kako izbrati</h2>
      <ul>
        <li>
          <strong>Za preizkus</strong> zadostuje brezplačna različica, vendar v brezplačna orodja ne
          vnašajte poslovnih podatkov strank. Pogoji uporabe podatkov so pri brezplačnih paketih
          praviloma drugačni kot pri poslovnih.
        </li>
        <li>
          <strong>Za podjetje</strong> izberite poslovni paket (Team, Business, Workspace ali
          Microsoft 365 Copilot). Ti imajo skrbniške nastavitve in pogodbene zaveze glede podatkov.
        </li>
        <li>
          <strong>Izbira orodja</strong> je pogosto odvisna od okolja, v katerem že delate: Copilot
          za Microsoft 365, Gemini za Google Workspace, ChatGPT ali Claude, kadar želite najmočnejši
          samostojni asistent.
        </li>
      </ul>
      <p>
        Cene osvežujemo mesečno. Ste opazili spremembo?
        <a href="https://github.com/AnzeNocAI/ej-aj/issues">Sporočite jo na GitHubu</a>.
      </p>
    </div>
  </div>
</Base>

<style>
  .how {
    color: var(--muted);
    font-size: 0.98rem;
    margin-bottom: 8px;
  }
  .group h2 {
    font-size: 1.2rem;
    margin: 32px 0 12px;
  }
  .table-wrap {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
  }
  .plans {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .plans th,
  .plans td {
    text-align: left;
    vertical-align: top;
    padding: 14px 16px;
    border-bottom: 1px solid var(--line);
  }
  .plans thead th {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    background: var(--bg);
  }
  .plans tbody tr:last-child > * {
    border-bottom: 0;
  }
  .num {
    text-align: right !important;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .name {
    display: block;
    font-weight: 700;
  }
  .sub,
  .note,
  .sources {
    display: block;
    margin-top: 6px;
    font-size: 0.82rem;
    color: var(--muted);
    font-weight: 400;
  }
  .use {
    min-width: 260px;
  }
  .notes {
    margin-top: 16px;
  }
  @media (max-width: 760px) {
    .table-wrap {
      border: 0;
      background: transparent;
    }
    .plans thead {
      display: none;
    }
    .plans,
    .plans tbody,
    .plans tr,
    .plans th,
    .plans td {
      display: block;
      width: 100%;
    }
    .plans tr {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      margin-bottom: 12px;
      padding: 6px 0;
    }
    .plans th,
    .plans td {
      border-bottom: 0;
      padding: 6px 16px;
    }
    .plans td.num {
      display: flex;
      justify-content: space-between;
    }
    .plans td.num::before {
      content: attr(data-label);
      color: var(--muted);
      font-size: 0.85rem;
    }
    .use {
      min-width: 0;
    }
  }
</style>
