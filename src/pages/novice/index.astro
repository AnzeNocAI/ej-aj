---
import Base from '../../layouts/Base.astro';
import { getPosts, postPath } from '../../lib';
import { TYPE_LABEL, formatDate } from '../../site';

const posts = await getPosts();
---

<Base
  title="AI novice v slovenščini"
  description="Tedenski pregledi AI novic in članki o novih modelih in orodjih (ChatGPT, Claude, Gemini, Copilot), z viri in razlago, kaj novost pomeni za podjetja."
>
  <div class="wrap narrow">
    <header class="article-head">
      <span class="eyebrow">Arhiv</span>
      <h1>Novice</h1>
      <p class="lede">Tedenski pregledi in članki, najnovejši na vrhu.</p>
    </header>
    <ul class="post-list">
      {
        posts.map((post) => (
          <li>
            <div class="meta">
              <span class="tag">{TYPE_LABEL[post.data.type]}</span>
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            </div>
            <h2>
              <a href={postPath(post)}>{post.data.title}</a>
            </h2>
            <p>{post.data.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
