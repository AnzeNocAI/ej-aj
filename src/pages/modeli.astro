---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatDate } from '../site';
import NarocnineTabela from '../components/NarocnineTabela.astro';
import '../styles/tabele.css';
import { PRODUCTS, host, sortPlans } from '../cene';

// Subscriptions (src/data/narocnine.yaml): what a person or a company pays per seat.
const plans = sortPlans(await getCollection('narocnine'));
const groups = [
  { key: 'podjetje', title: 'Za podjetja in ekipe' },
  { key: 'posameznik', title: 'Za posameznike' },
] as const;

// Models (src/data/modeli.yaml): API prices per million tokens.
const PROVIDER_ORDER = ['Anthropic', 'OpenAI', 'Google', 'Mistral', 'Meta', 'DeepSeek', 'CJVT / UL FRI'];
const models = (await getCollection('modeli')).sort((a, b) => {
  const pa = PROVIDER_ORDER.indexOf(a.data.ponudnik);
  const pb = PROVIDER_ORDER.indexOf(b.data.ponudnik);
  if (pa !== pb) return (pa === -1 ? 99 : pa) - (pb === -1 ? 99 : pb);
  return (b.data.cena_izhod ?? 0) - (a.data.cena_izhod ?? 0);
});

const lastChecked = new Date(
  Math.max(...models.map((m) => m.data.preverjeno.valueOf()), ...plans.map((p) => p.data.preverjeno.valueOf())),
);
const usd = new Intl.NumberFormat('sl-SI', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const num = new Intl.NumberFormat('sl-SI');

function apiPrice(v: number | null) {
  return v === null ? 'ni podatka' : `${usd.format(v)} $`;
}
function context(v: number | null) {
  if (v === null) return 'ni podatka';
  if (v >= 1_000_000) return `${num.format(v / 1_000_000)} mio.`;
  return `${num.format(Math.round(v / 1000))} tisoč`;
}
// Link labels: hostname, numbered when one model cites the same host twice.
function sourceLabels(urls: string[]) {
  const hosts = urls.map(host);
  return hosts.map((h, i) => {
    const same = hosts.filter((x) => x === h).length;
    return same > 1 ? `${h} (${hosts.slice(0, i + 1).filter((x) => x === h).length})` : h;
  });
}
---

<Base
  title="Cene AI orodij in primerjava modelov"
  description="Naročnine za ChatGPT, Claude, Gemini, Microsoft Copilot in druga AI orodja ter cene modelov prek API-ja. Za posameznike in podjetja, z viri in datumom preverjanja."
>
  <div class="wrap">
    <header class="article-head narrow">
      <span class="eyebrow">Modeli in cene</span>
      <h1>AI orodja in modeli: cene na enem mestu</h1>
      <p class="lede">
        Koliko stanejo naročnine na ChatGPT, Claude, Gemini, Copilot in druga orodja ter koliko
        stane uporaba modelov prek API-ja. Vsak podatek ima vir. Zadnje preverjanje:{' '}
        {formatDate(lastChecked)}.
      </p>
      <nav class="jump" aria-label="Na tej strani">
        <a href="#narocnine">Naročnine</a>
        <a href="#modeli">Modeli prek API</a>
        <a href="#kako-izbrati">Kako izbrati</a>
      </nav>
    </header>

    <section id="narocnine" class="block">
      <h2>Naročnine</h2>
      <p class="how narrow">
        To plačate, ko orodje uporabljate v brskalniku, aplikaciji ali v Wordu in Gmailu. Cene so na
        uporabnika na mesec, popust za letno plačilo je naveden posebej. Ponudniki cene prilagajajo
        državi; pri vsaki postavki je označeno, ali vključuje DDV.
      </p>
      <p class="how narrow">
        Cene po orodjih:{' '}
        {PRODUCTS.map((p, i) => (
          <>
            {i > 0 && ' · '}
            <a href={`/cene/${p.slug}/`}>{p.ime.replace(/ \(.*\)$/, '')}</a>
          </>
        ))}
      </p>

      {
        groups.map((g) => {
          const rows = plans.filter((p) => p.data.za === g.key);
          return (
            <>
              <h3>{g.title}</h3>
              <NarocnineTabela plans={rows} />
            </>
          );
        })
      }
    </section>

    <section id="modeli" class="block">
      <h2>Modeli prek API</h2>
      <p class="how narrow">
        To plačate, ko model uporabljate v lastni aplikaciji ali avtomatizaciji prek{' '}
        <a href="/slovar/api/">API-ja</a>. Cene so v ameriških dolarjih na milijon{' '}
        <a href="/slovar/token/">tokenov</a> (več sto tisoč besed; slovensko besedilo porabi več
        tokenov kot angleško). <a href="/slovar/kontekstno-okno/">Kontekstno okno</a> pove, koliko
        besedila model upošteva naenkrat. Pod "Dostop" piše, v katerih orodjih in paketih je model
        na voljo.
      </p>

      <div class="table-wrap">
        <table class="data">
          <thead>
            <tr>
              <th scope="col">Model</th>
              <th scope="col" class="num">Vhod</th>
              <th scope="col" class="num">Izhod</th>
              <th scope="col" class="num">Kontekst</th>
              <th scope="col">Za kaj</th>
            </tr>
          </thead>
          <tbody>
            {
              models.map((m) => (
                <tr id={m.id}>
                  <th scope="row">
                    <span class="name">{m.data.ime}</span>
                    <span class="provider">
                      {m.data.ponudnik}
                      {m.data.odprte_utezi && <span class="tag">odprte uteži</span>}
                    </span>
                  </th>
                  <td class="num" data-label="Vhod">{apiPrice(m.data.cena_vhod)}</td>
                  <td class="num" data-label="Izhod">{apiPrice(m.data.cena_izhod)}</td>
                  <td class="num" data-label="Kontekst">{context(m.data.kontekst)}</td>
                  <td class="use" data-label="Za kaj">
                    {m.data.za_kaj}
                    {m.data.opomba && <span class="note">{m.data.opomba}</span>}
                    <span class="sources">
                      Dostop: {m.data.dostop}. Vir:{' '}
                      {sourceLabels(m.data.viri).map((label, i) => (
                        <>
                          {i > 0 && ', '}
                          <a href={m.data.viri[i]}>{label}</a>
                        </>
                      ))}
                    </span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <div class="prose narrow notes" id="kako-izbrati">
      <h2>Kako izbrati</h2>
      <p>
        Za službene podatke izberite poslovni paket (Business, Team, Google Workspace ali Microsoft
        365 Copilot). Ti imajo skrbniške nastavitve in pogodbo o obdelavi podatkov, pri brezplačnih
        in osebnih paketih pa se pogovori lahko uporabijo za učenje modelov. Več o tem v vodniku{' '}
        <a href="/vodniki/varna-raba-ai-v-podjetju/">Kateri podatki ne sodijo v ChatGPT</a>.
      </p>
      <p>
        Izbira je pogosto odvisna od okolja, v katerem podjetje že dela: Gemini je vključen v Google
        Workspace Business Standard, Copilot se doda k Microsoft 365. ChatGPT in Claude sta
        samostojni orodji. Postopek izbire je opisan v vodniku{' '}
        <a href="/vodniki/kako-izbrati-ai-orodje-za-podjetje/">Kako izbrati AI orodje za podjetje</a>.
      </p>
      <p>
        API je smiseln za avtomatizacije z veliko ponovitvami, na primer razvrščanje e-pošte ali
        izpisovanje podatkov iz računov. Izberite najcenejši model, ki nalogo še zanesljivo opravi,
        in ga preizkusite na svojih primerih. Kadar podatki ne smejo zapustiti hiše, pridejo v poštev
        modeli z odprtimi utežmi, ki jih poganjate sami. To zahteva zmogljivo strojno opremo in
        nekoga, ki sistem vzdržuje.
      </p>
      <p>
        Stolpec "Za kaj" je naše mnenje, ostali podatki so povzeti po uradnih straneh ponudnikov.
        Obe tabeli osvežujemo mesečno. Ste opazili napako?{' '}
        <a href="https://github.com/ej-aj-pro/ej-aj/issues">Sporočite jo na GitHubu</a>.
      </p>
    </div>
  </div>
</Base>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }
  .jump a {
    padding: 4px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.9rem;
    text-decoration: none;
    background: var(--surface);
  }
  .block,
  #kako-izbrati {
    scroll-margin-top: 80px;
  }
  .block {
    margin: 40px 0;
  }
  .block h2 {
    font-family: var(--serif);
    font-size: 1.6rem;
    margin: 0 0 10px;
  }
  .block h3 {
    font-size: 1.1rem;
    margin: 28px 0 12px;
  }
  .how {
    color: var(--muted);
    font-size: 0.98rem;
    margin: 0 0 8px;
  }
  .provider {
    display: flex;
    gap: 6px;
    align-items: center;
    flex-wrap: wrap;
    font-weight: 400;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .notes {
    margin-top: 16px;
  }

  @media (max-width: 760px) {
    /* The sticky header wraps to two rows on phones. */
    .block,
    #kako-izbrati {
      scroll-margin-top: 150px;
    }
  }
</style>
