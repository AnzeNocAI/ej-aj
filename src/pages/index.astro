---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts } from '../lib';

const posts = (await getPosts()).slice(0, 6);

---

<Base>
  <section class="wrap hero">
    <span class="eyebrow">ej-aj.si</span>
    <h1>Umetna inteligenca <em>po slovensko</em>.</h1>
    <p>
      Vsak petek pregled AI novic tedna in kratka razlaga, kaj pomenijo za podjetja pri nas. Ob
      tem še primerjava modelov, cene orodij, slovar in vodniki.
    </p>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <h2>Zadnje</h2>
      <a href="/novice/">Vse novice</a>
    </div>
    <div class="grid">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <h2>Primerjava modelov</h2>
      <a href="/modeli/">Odpri primerjavo</a>
    </div>
    <p class="section-lede">
      Claude, GPT, Gemini, Mistral, Llama, DeepSeek in slovenski GaMS: cene, kontekstno okno in za
      kaj je kateri model primeren. Vsak podatek ima vir.
    </p>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <h2>AI slovar</h2>
      <a href="/slovar/">Vsi izrazi</a>
    </div>
    <p class="section-lede">
      Token, agent, MCP, halucinacija: izrazi, ki jih srečate ob uporabi AI, razloženi po domače.
      <a href="/slovar/">Odpri slovar</a>
    </p>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <h2>Vodniki</h2>
      <a href="/vodniki/">Vsi vodniki</a>
    </div>
    <p class="section-lede">
      Kaj velja, kaj smete in kako se česa lotiti, ko AI uvajate v podjetje.
      <a href="/vodniki/ai-act-za-slovenska-podjetja/">AI Act za slovenska podjetja</a>
    </p>
  </section>
</Base>
