---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import Newsletter from '../components/Newsletter.astro';
import { getPosts } from '../lib';
import stat from '../data/statistika.json';

const posts = (await getPosts()).slice(0, 6);

// Headline number for the statistics teaser, from the same data as /statistika/.
const trend = stat.podjetja_trend;
const entYear = trend.leta[trend.leta.length - 1];
const entSI = trend.SI[trend.SI.length - 1];
const entEU = trend.EU[trend.EU.length - 1];
const pct = (v: number) => `${new Intl.NumberFormat('sl-SI', { minimumFractionDigits: 1 }).format(v)} %`;

---

<Base>
  <section class="wrap hero">
    <span class="eyebrow">ej-aj.si</span>
    <h1>Umetna inteligenca <em>po slovensko</em>.</h1>
    <p>
      Vsak petek pregled AI novic tedna in kratka razlaga, kaj pomenijo za podjetja pri nas. Ob
      tem še cene orodij in modelov, statistika, slovar in vodniki.
    </p>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <h2>Zadnje</h2>
      <a href="/novice/">Vse novice</a>
    </div>
    <div class="grid">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <div class="wrap">
    <Newsletter />
  </div>

  <section class="wrap section">
    <div class="section-head">
      <h2>Modeli in cene</h2>
      <a href="/modeli/">Odpri primerjavo</a>
    </div>
    <p class="section-lede">
      Naročnine za ChatGPT, Claude, Gemini, Copilot in druga orodja, za posameznike in podjetja, ter
      cene modelov prek API-ja, od Clauda in GPT do slovenskega GaMS. Vsak podatek ima vir.
    </p>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <h2>AI v Sloveniji v številkah</h2>
      <a href="/statistika/">Odpri statistiko</a>
    </div>
    <p class="section-lede">
      Leta {entYear} je AI uporabljalo {pct(entSI)} slovenskih podjetij z vsaj 10 zaposlenimi (EU{' '}
      {pct(entEU)}). Kje smo med državami EU, kdo AI uporablja in katere klepetalnike, v grafih s
      podatki Eurostata, SURS, Microsofta in StatCounterja.
    </p>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <h2>AI slovar</h2>
      <a href="/slovar/">Vsi izrazi</a>
    </div>
    <p class="section-lede">
      Token, agent, MCP, halucinacija: izrazi, ki jih srečate ob uporabi AI, razloženi po domače.
      <a href="/slovar/">Odpri slovar</a>
    </p>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <h2>Vodniki</h2>
      <a href="/vodniki/">Vsi vodniki</a>
    </div>
    <p class="section-lede">
      Kaj velja, kaj smete in kako se česa lotiti, ko AI uvajate v podjetje.
      <a href="/vodniki/ai-act-za-slovenska-podjetja/">AI Act za slovenska podjetja</a>
    </p>
  </section>
</Base>
