---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import Newsletter from '../components/Newsletter.astro';
import Video from '../components/Video.astro';
import { getCollection } from 'astro:content';
import { getPosts, postPath } from '../lib';
import stat from '../data/statistika.json';

const all = await getPosts();
// Handbook steps have their own section, so they don't push the digests out of "Zadnje".
const posts = all.filter((p) => !p.data.serija).slice(0, 6);
const handbook = all.filter((p) => p.data.serija === 'prirocnik').sort((a, b) => (a.data.korak ?? 99) - (b.data.korak ?? 99));
const videos = (await getCollection('videi'))
  .filter((v) => v.data.izpostavljen)
  .sort((a, b) => b.data.datum.valueOf() - a.data.datum.valueOf())
  .slice(0, 3);

// Headline number for the statistics teaser, from the same data as /statistika/.
const trend = stat.podjetja_trend;
const entYear = trend.leta[trend.leta.length - 1];
const entSI = trend.SI[trend.SI.length - 1];
const entEU = trend.EU[trend.EU.length - 1];
const pct = (v: number) => `${new Intl.NumberFormat('sl-SI', { minimumFractionDigits: 1 }).format(v)} %`;

---

<Base>
  <section class="wrap hero">
    <span class="eyebrow">ej-aj.si</span>
    <h1>Umetna inteligenca <em>po slovensko</em>.</h1>
    <p>
      AI novice, orodja in nasveti za slovenska podjetja.
    </p>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <h2>Zadnje</h2>
      <a href="/novice/">Vse novice</a>
    </div>
    <div class="grid">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <div class="wrap">
    <Newsletter />
  </div>

  <section class="wrap section">
    <div class="section-head">
      <h2>Priročnik: kako dobro uporabljati Claude</h2>
      <a href="/prirocnik/">Celoten priročnik</a>
    </div>
    <p class="section-lede">
      Od prvega dobrega prompta do agenta, ki dela sam: kontekst podjetja, Claude Code, skilli,
      subagenti, hooki in rutine. Pet skillov v slovenščini lahko tudi <a href="/skilli/">brezplačno prenesete</a>.
    </p>
    <ol class="handbook">
      {
        handbook.map((p) => (
          <li>
            <a href={postPath(p)}>{p.data.title.split(':')[0]}</a>
          </li>
        ))
      }
    </ol>
  </section>

  {
    videos.length > 0 && (
      <section class="wrap section">
        <div class="section-head">
          <h2>Za ogled</h2>
          <a href="/videi/">Vsi videi</a>
        </div>
        <div class="video-row">
          {videos.map((v) => (
            <Video video={v} compact />
          ))}
        </div>
      </section>
    )
  }

  <section class="wrap section">
    <div class="section-head">
      <h2>Modeli in cene</h2>
      <a href="/modeli/">Odpri primerjavo</a>
    </div>
    <p class="section-lede">
      Naročnine za ChatGPT, Claude, Gemini, Copilot in druga orodja, za posameznike in podjetja, ter
      cene modelov prek API-ja, od Clauda in GPT do slovenskega GaMS. Vsak podatek ima vir.
    </p>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <h2>AI v Sloveniji v številkah</h2>
      <a href="/statistika/">Odpri statistiko</a>
    </div>
    <p class="section-lede">
      Leta {entYear} je AI uporabljalo {pct(entSI)} slovenskih podjetij z vsaj 10 zaposlenimi (EU{' '}
      {pct(entEU)}). Kje smo med državami EU, kdo AI uporablja in katere klepetalnike, v grafih s
      podatki Eurostata, SURS, Microsofta in StatCounterja.
    </p>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <h2>AI slovar</h2>
      <a href="/slovar/">Vsi izrazi</a>
    </div>
    <p class="section-lede">
      Token, agent, MCP, halucinacija: izrazi, ki jih srečate ob uporabi AI, razloženi po domače.
      <a href="/slovar/">Odpri slovar</a>
    </p>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <h2>Vodniki</h2>
      <a href="/vodniki/">Vsi vodniki</a>
    </div>
    <p class="section-lede">
      Kaj velja, kaj smete in kako se česa lotiti, ko AI uvajate v podjetje.
      <a href="/vodniki/ai-act-za-slovenska-podjetja/">AI Act za slovenska podjetja</a>
    </p>
  </section>
</Base>

<style>
  .handbook {
    columns: 2 280px;
    column-gap: 32px;
    margin: 12px 0 0;
    padding-left: 1.4em;
  }
  .handbook li {
    margin: 0 0 6px;
    break-inside: avoid;
  }
  .video-row {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 24px;
  }
</style>
